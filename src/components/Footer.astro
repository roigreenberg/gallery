---
// Footer.astro - Minimalist footer with copyright and EXIF info summary
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-900 bg-slate-950/90 py-10 text-slate-500 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-right">
    <div>
      <p class="text-slate-400 font-medium">
        &copy; {year}
        <span data-lang="he">רועי גרינברג &bull; כל הזכויות שמורות.</span>
        <span data-lang="en">Roi Greenberg &bull; All rights reserved.</span>
      </p>
      <p class="text-[11px] text-slate-600 mt-1">
        <span data-lang="he">נבנה באמצעות Astro, Vue 3 ו-Tailwind CSS &bull; מותאם לפריסה ב-GitHub Pages.</span>
        <span data-lang="en">Built with Astro, Vue 3 & Tailwind CSS &bull; Optimized for GitHub Pages.</span>
      </p>
    </div>

    <div class="flex items-center gap-4 text-slate-400">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span data-lang="he">צילום שדה אותנטי</span>
        <span data-lang="en">Authentic Field Photography</span>
      </span>
      <span>&bull;</span>
      <span data-lang="he">נתוני EXIF פתוחים</span>
      <span data-lang="en">Open EXIF Data</span>
    </div>
  </div>
</footer>
