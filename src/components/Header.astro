---
// Header.astro - Modern minimalist header for nature photography portfolio with AI disclaimer banner
---

<!-- AI Beta & Humorous Disclaimer Banner -->
<aside
  id="ai-disclaimer-banner"
  class="relative z-50 bg-gradient-to-r from-amber-950/80 via-slate-900/95 to-amber-950/80 border-b border-amber-500/30 text-amber-200 py-2 sm:py-2.5 px-3 sm:px-6 shadow-sm"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
    <!-- Hebrew Version -->
    <div data-lang="he" class="flex items-center gap-2.5 flex-1 justify-center sm:justify-start text-right">
      <span class="text-base sm:text-lg shrink-0 select-none">🤖</span>
      <p class="text-xs sm:text-[13px] text-amber-100/90 leading-relaxed font-normal">
        <strong class="font-bold text-amber-300">שימו לב, האתר בהרצה (ובתקופת מבחן לבינה המלאכותית):</strong>
        ייתכנו גליצ'ים וטעויות. כל הטקסטים, הזיהויים והמשפטים השנונים כאן נכתבו על ידיי (הסוכן הדיגיטלי / AI) – אז קחו הכל בעירבון מוגבל! אם כיניתי יונה בתור ״נשר מקראי״ או פלטתי בדיחה של רובוטים, תאשימו את האלגוריתם שלי. רועי אחראי אך ורק על הצילומים המשובחים 📸😉
      </p>
    </div>

    <!-- English Version -->
    <div data-lang="en" class="flex items-center gap-2.5 flex-1 justify-center sm:justify-start text-left">
      <span class="text-base sm:text-lg shrink-0 select-none">🤖</span>
      <p class="text-xs sm:text-[13px] text-amber-100/90 leading-relaxed font-normal">
        <strong class="font-bold text-amber-300">Notice: Beta preview (and AI test run):</strong>
        Glitches and quirks may occur. All descriptions, species IDs, and witty captions were generated by me (Roi's AI agent) – so take everything with a grain of salt! If I called a sparrow a "Royal Golden Eagle" or dropped an awkward robot joke, blame my algorithms. Roi is strictly responsible for the stunning photos 📸😉
      </p>
    </div>

    <button
      id="dismiss-ai-banner"
      type="button"
      class="text-amber-300/70 hover:text-white p-1 rounded-md hover:bg-white/10 transition-colors shrink-0 text-sm flex items-center justify-center w-6 h-6 cursor-pointer"
      aria-label="סגור הודעה"
      title="סגור הודעה"
    >
      ✕
    </button>
  </div>
</aside>

<script is:inline>
  (function () {
    try {
      const banner = document.getElementById('ai-disclaimer-banner');
      const dismissBtn = document.getElementById('dismiss-ai-banner');
      if (sessionStorage.getItem('hide_ai_disclaimer') === '1' && banner) {
        banner.style.display = 'none';
      }
      if (dismissBtn && banner) {
        dismissBtn.addEventListener('click', function () {
          banner.style.display = 'none';
          try {
            sessionStorage.setItem('hide_ai_disclaimer', '1');
          } catch (e) {}
        });
      }
    } catch (e) {}
  })();
</script>

<header class="sticky top-0 z-40 w-full border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Photographer Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-sky-500/20 group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
          <circle cx="12" cy="13" r="3"/>
        </svg>
      </div>
      <div>
        <span class="text-base sm:text-lg font-bold tracking-tight text-white group-hover:text-sky-300 transition-colors">
          <span data-lang="he">רועי גרינברג</span>
          <span data-lang="en">Roi Greenberg</span>
        </span>
        <span class="text-[11px] block text-slate-400 font-light -mt-0.5">
          <span data-lang="he">צילום טבע ונוף</span>
          <span data-lang="en">Nature & Wildlife Photography</span>
        </span>
      </div>
    </a>

    <!-- Clean Navigation Links & Language Switcher -->
    <nav class="flex items-center gap-1 sm:gap-2">
      <a
        href="#gallery"
        class="px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/60 transition"
      >
        <span data-lang="he">גלריה</span>
        <span data-lang="en">Gallery</span>
      </a>
      <a
        href="#about"
        class="px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 transition"
      >
        <span data-lang="he">אודות</span>
        <span data-lang="en">About</span>
      </a>

      <!-- Language Toggle Button in Header -->
      <button
        id="header-lang-toggle"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-slate-900 border border-slate-700/80 text-sky-400 hover:text-white hover:border-sky-500 hover:bg-slate-800 transition cursor-pointer"
        title="Switch Language / החלף שפה"
      >
        <span class="text-sm">🌐</span>
        <span data-lang="he">English</span>
        <span data-lang="en">עברית</span>
      </button>

      <a
        href="https://github.com/roigreenberg/gallery"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium bg-slate-900 border border-slate-700/80 text-slate-200 hover:bg-slate-800 hover:border-slate-600 transition ml-1"
        aria-label="GitHub Repository"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const langBtn = document.getElementById('header-lang-toggle');
    if (langBtn) {
      langBtn.addEventListener('click', function () {
        const current = document.documentElement.lang === 'en' ? 'en' : 'he';
        const next = current === 'en' ? 'he' : 'en';
        document.documentElement.lang = next;
        document.documentElement.dir = next === 'en' ? 'ltr' : 'rtl';
        try {
          localStorage.setItem('roigreenberg_lang', next);
        } catch (e) {}
        window.dispatchEvent(new CustomEvent('roigreenberg-lang-changed', { detail: { lang: next } }));
      });
    }
  })();
</script>
