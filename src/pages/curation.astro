---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CurationBoard from '../components/CurationBoard.vue';
import photosData from '../data/photos.json';
import '../styles/global.css';

const pageTitle = "חדר אוצרות לתערוכה וקיר תמונות | רועי גרינברג";
const pageDescription = "מרחב אוצרות סגור לדירוג, בחירת תצלומים וסדרות לתערוכה ולקיר תמונות.";
---

<!doctype html>
<html lang="he" dir="rtl" class="scroll-smooth dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow" />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />

		<!-- Hebrew Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

		<style>
			body {
				font-family: 'Assistant', system-ui, -apple-system, sans-serif;
			}
		</style>
	</head>
	<body class="min-h-screen bg-[#07090e] text-slate-100 antialiased selection:bg-indigo-500 selection:text-white flex flex-col justify-between">
		
		<!-- Site Header -->
		<Header />

		<!-- Main Curation App -->
		<main class="flex-1 pb-16">
			<CurationBoard client:only="vue" initialPhotos={photosData} />
		</main>

		<!-- Site Footer -->
		<Footer />

	</body>
</html>
