# Google Gemini API Key for AI tagging & content editing
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 / S3-compatible Object Storage Credentials
# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Public CDN / Custom Domain for your bucket (e.g., https://media.roigreenberg.com or https://pub-xxxxxx.r2.dev)
R2_PUBLIC_URL=https://your-public-r2-domain.com
